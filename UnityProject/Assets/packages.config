  <!-- Stage 7 presence client: MagicOnion.Client.Unity's precompiled
       references (MagicOnion.Client.dll, Grpc.Net.Client.dll) + the gRPC
       transport YetAnotherHttpHandler plugs into. Versions must match the
       HubServer's MagicOnion 7.0.0 / MessagePack 3.1.10 pin.
       NOTE: NuGetForUnity runs with slimRestore — every transitive dependency
       is listed EXPLICITLY (MagicOnion.Client → Serialization.MessagePack +
       Shared; Grpc.Net.Client → Net.Common + Logging.Abstractions +
       DiagnosticSource). Keep this list closed under version bumps. -->
  <package id="MagicOnion.Client" version="7.0.0" />
  <package id="MagicOnion.Abstractions" version="7.0.0" />
  <package id="MagicOnion.Shared" version="7.0.0" />
  <package id="MagicOnion.Serialization.MessagePack" version="7.0.0" />
  <package id="Grpc.Net.Client" version="2.66.0" />
  <package id="Grpc.Net.Common" version="2.66.0" />
  <package id="Grpc.Core.Api" version="2.66.0" />
  <package id="Microsoft.Extensions.Logging.Abstractions" version="8.0.0" />
  <package id="System.Diagnostics.DiagnosticSource" version="8.0.1" />
</packages>